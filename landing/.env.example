# Copiá este archivo a .env (que NO se commitea) y completá los valores.
# Todo lo que empieza con VITE_ termina dentro del JS público: acá van SOLO claves públicas.
# NUNCA pongas la service_role key ni claves de IA en este archivo.

# Supabase > Project Settings > API: URL del proyecto y clave publishable (o anon legacy).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# PostHog > Project settings: Project API key (empieza con phc_). Es pública por diseño.
VITE_POSTHOG_KEY=
# https://us.i.posthog.com (EE.UU.) o https://eu.i.posthog.com (UE)
VITE_POSTHOG_HOST=https://us.i.posthog.com

# URL pública del sitio (para la imagen al compartir). Por defecto: https://bereano-landing.pages.dev
VITE_SITE_URL=
